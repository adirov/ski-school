# ---- Site ----
# Public origin without trailing slash. Used for canonical, hreflang, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
# Content mode. production (default) = only confirmed services and published articles, no badges or TODO notes.
# preview = internal review: demo cards, drafts and TODO notes are shown and every page is noindex.
NEXT_PUBLIC_SITE_MODE=production
# Search indexing. Off unless set to 1. Requires NEXT_PUBLIC_SITE_URL to be the real https origin (the build fails otherwise).
# Keep it off on staging copies.
NEXT_PUBLIC_ALLOW_INDEXING=0

# ---- Lead delivery (pick at least one before launch) ----
# The request form is shown only when one of these is set at build time; otherwise pages show phone booking instead.
# Telegram bot: create with @BotFather, add the bot to a chat, put the chat id here.
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=
# Or any HTTPS webhook (Make, Zapier, n8n, your CRM). Receives JSON.
LEAD_WEBHOOK_URL=
# Local testing only: validate the form without delivering it. The UI says so explicitly.
LEAD_DRY_RUN=0
# Secret for the anti-spam form token (any long random string).
LEAD_FORM_SECRET=change-me

# ---- Analytics (optional; loaded only after visitor consent) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
