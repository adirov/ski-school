# ---- Site ----
# Public origin without trailing slash. Used for canonical, hreflang, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
# preview = shows demo offers and draft articles with "Пример"/"Черновик" badges and sets noindex on every page.
# production = hides demo/draft content, allows indexing.
NEXT_PUBLIC_SITE_MODE=preview

# ---- Lead delivery (pick at least one before launch) ----
# Telegram bot: create with @BotFather, add the bot to a chat, put the chat id here.
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=
# Or any HTTPS webhook (Make, Zapier, n8n, your CRM). Receives JSON.
LEAD_WEBHOOK_URL=
# Local testing only: validate the form without delivering it. The UI says so explicitly.
LEAD_DRY_RUN=0
# Secret for the anti-spam form token (any long random string).
LEAD_FORM_SECRET=change-me

# ---- Analytics (optional; loaded only after visitor consent) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
